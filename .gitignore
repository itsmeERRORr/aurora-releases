# macOS
.DS_Store

# Xcode user state
*.xcuserstate
xcuserdata/

# Build output
build/
DerivedData/

# Publish output
# - DMGs live in GitHub Releases assets; the local copies are throwaway.
# - releases/appcast.xml IS tracked (mirrors what's currently on GitHub).
# - releases/.private/ would hold any on-disk key material; never tracked.
releases/*.dmg
releases/.private/
releases/Aurora-*.app

# Local env
.env.local
